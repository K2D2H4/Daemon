node_modules/
__pycache__/
.env
*.pyc
.venv/
dist/
.DS_Store

# Runtime user data: the markdown source of truth and its sqlite index.
# Root-anchored on purpose — a bare `memory/` would also swallow the
# daemon/memory/ source package.
/data/
/memory/
/persona/

# ...and any copy of it. `/data/` matches that one path exactly, so the obvious
# way to set a data dir aside before a reinstall - `mv data data.old-$(date +%F)`
# - produced a directory git was happy to track. Caught by a credential scan
# reporting the *contents* of a day's conversation as staged.
/data.*/
/data-*/

# Tooling caches
.playwright-mcp/
.pytest_cache/
.ruff_cache/
