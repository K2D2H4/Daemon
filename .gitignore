node_modules/
__pycache__/
.env

# ...and any copy of it, for the same reason `/data.*/` below exists: setting the
# real thing aside before an edit - `cp .env .env.bak.$(date +%s)`, or the
# `.env.old-YYYY-MM-DD` an install leaves behind - produced a file holding every
# key in it that git was happy to track. `.env` matches that one name exactly.
# `.env.example` is the copy that is meant to be here, and carries no secrets.
.env.*
!.env.example

*.pyc
.venv/
dist/
.DS_Store

# Runtime user data: the markdown source of truth and its sqlite index.
# Root-anchored on purpose — a bare `memory/` would also swallow the
# daemon/memory/ source package.
/data/
/memory/
/persona/

# ...and any copy of it. `/data/` matches that one path exactly, so the obvious
# way to set a data dir aside before a reinstall - `mv data data.old-$(date +%F)`
# - produced a directory git was happy to track. Caught by a credential scan
# reporting the *contents* of a day's conversation as staged.
/data.*/
/data-*/

# Tooling caches
.playwright-mcp/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
