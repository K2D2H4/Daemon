# Copy to .env . Never commit .env (already gitignored).

# --- preset: offline | balanced | quality -----------------------------------
# offline  : everything local, voice unavailable
# balanced : chat+reflection hosted, proactive judge local, voice available
# quality  : everything hosted
DAEMON_PRESET=balanced

# Voice is opt-in (PLAN 6.5). Text mode is a complete product, so a text-only
# install is not forced to hold a key it never uses. Leaving this off means the
# hosted voice keys are not required at startup.
DAEMON_VOICE_ENABLED=false

# --- local provider ---------------------------------------------------------
DAEMON_OLLAMA_BASE_URL=http://127.0.0.1:11434
DAEMON_OLLAMA_MODEL=qwen3:14b

# --- hosted providers (BYOK - bring your own key) ---------------------------
# Only the ones your preset actually routes to are required. Startup fails loudly
# if a routed provider has no key - a silent downgrade to a weaker model is worse.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

DAEMON_ANTHROPIC_MODEL=claude-sonnet-5
# The OpenAI and Gemini providers are not implemented yet (M1b, for voice).
DAEMON_OPENAI_MODEL=
DAEMON_GEMINI_MODEL=

# --- routing overrides (optional) -------------------------------------------
# Per-task override on top of the preset, as JSON. See PLAN 3.2.
#   {"reflection": "ollama"}
DAEMON_ROUTE_OVERRIDES=
# One optional provider to try once when the routed provider fails. Unset means
# the error propagates instead of being silently papered over.
DAEMON_FALLBACK_PROVIDER=

# --- channel ----------------------------------------------------------------
# Create a bot with @BotFather, then put your own numeric Telegram user id in
# the allowlist. Anyone not on the allowlist is ignored.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- data -------------------------------------------------------------------
# Markdown is the source of truth; the sqlite file is a rebuildable index.
DAEMON_DATA_DIR=./data

# --- local control plane ----------------------------------------------------
# Loopback on purpose: the HTTP surface is local, not a public API.
DAEMON_HOST=127.0.0.1
DAEMON_PORT=8787
