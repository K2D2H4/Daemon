# Reference for every setting. You do not have to edit this file by hand:
# `daemon setup` asks only what your preset needs, verifies each key against the
# provider before saving it, and writes .env for you at mode 0600. This file is
# the explanation; that command is the path. `daemon setup --check` says what is
# still missing without asking anything.
#
# To do it by hand anyway: copy to .env . Never commit .env (already gitignored).

# --- preset: offline | balanced | quality -----------------------------------
# offline  : everything local, voice unavailable
# balanced : chat+reflection hosted, proactive judge local, voice available
# quality  : everything hosted
DAEMON_PRESET=balanced

# Voice is opt-in (PLAN 6.5). Text mode is a complete product, so a text-only
# install is not forced to hold a key it never uses. Leaving this off means the
# hosted voice keys are not required at startup.
DAEMON_VOICE_ENABLED=false

# --- local provider ---------------------------------------------------------
DAEMON_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Do not use a reasoning model here. Measured on an M4 Max, same three Korean
# questions: gemma3:4b answered in 1.7 s, qwen3:4b in 11.8 s - the difference is
# a chain of thought nobody ever sees, since Ollama returns it in a separate
# field that is discarded. It cannot be switched off either: `think: false` only
# stops Ollama separating it, so the reasoning becomes the reply, and Qwen3's own
# /no_think suffix does not survive the template. gemma3's Korean also read as
# more like a companion and less like a disclaimer.
DAEMON_OLLAMA_MODEL=gemma3:4b

# --- hosted providers (BYOK - bring your own key) ---------------------------
# Only the ones your preset actually routes to are required. Startup fails loudly
# if a routed provider has no key - a silent downgrade to a weaker model is worse.
# `daemon setup` checks each key against the provider before writing it, which is
# the difference between finding out now and finding out mid-conversation.
# Gemini: create the key in AI Studio (aistudio.google.com/apikey). An older
# Google "Standard" key is refused by the Gemini API if it is unrestricted, and
# all remaining Standard keys stop working in September 2026.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Which commercial model answers wherever the preset says "hosted":
# anthropic | openai | gemini. Per-task overrides below still win over this.
# The preset chooses *where* work runs; this chooses *whose model*. Keeping them
# separate is why there are three presets instead of nine.
DAEMON_HOSTED_PROVIDER=anthropic

DAEMON_ANTHROPIC_MODEL=claude-sonnet-5
DAEMON_OPENAI_MODEL=
DAEMON_GEMINI_MODEL=

# --- voice (opt-in) ---------------------------------------------------------
# The native-audio endpoint takes its own model id, not DAEMON_GEMINI_MODEL.
# Required once DAEMON_VOICE_ENABLED is true; no default, because a guessed id
# would fail on the first voice turn instead of at startup.
#   DAEMON_GEMINI_LIVE_MODEL=gemini-live-2.5-flash-preview
DAEMON_GEMINI_LIVE_MODEL=

# --- the wake gate (opt-in, needs voice on) ---------------------------------
# A voice session bills per minute, so holding one open in case you say something
# costs about 48x what 30 minutes a day costs (PLAN 6.5). Instead a free local VAD
# listens forever and only a matched wake phrase opens the paid session.
DAEMON_WAKE_ENABLED=false
# What the on-device recognizer actually returns when you say your wake phrase -
# comma-separated, and NOT the name you chose. It never emits a coined name:
# measured here, stable across three runs each, 헤이 데몬 comes back as 헤이 대문,
# 데몬 as 질문 and 루시야 as 루시. Yours will differ, because it depends on your
# voice; `daemon wake calibrate` measures it and writes the list. Spacing,
# punctuation and Unicode form are ignored when matching, and the phrase has to
# *start* what you said - these are ordinary Korean words, so matching one mid-sentence would open a
# paid session in the middle of a conversation with somebody else.
DAEMON_WAKE_ALIASES=
# The rest are the measured defaults; you should not need to touch them. Threshold
# is the VAD's speech probability; hangover is the silence that ends a phrase;
# pre-roll is how much audio from *before* speech started is kept, without which
# the first syllable is clipped and nothing matches; min/max bound what is worth
# transcribing and what may sit in memory; cooldown stops one phrase opening two
# sessions.
DAEMON_WAKE_VAD_THRESHOLD=0.5
DAEMON_WAKE_HANGOVER_MS=600
DAEMON_WAKE_PRE_ROLL_MS=300
DAEMON_WAKE_MIN_SPEECH_MS=200
DAEMON_WAKE_MAX_SEGMENT_MS=3000
DAEMON_WAKE_COOLDOWN_SECONDS=5.0

# --- recall (PLAN 4.3) ------------------------------------------------------
# Embedding model, pulled with `ollama pull bge-m3`. Multilingual on purpose:
# FTS5 alone misses inflected Korean, which is why vectors are in M1b at all.
DAEMON_EMBED_MODEL=bge-m3
# How many recalled items are injected per turn, and the recency half-life in
# days used when scoring them (similarity x decay x importance).
DAEMON_RECALL_LIMIT=6
DAEMON_RECALL_HALF_LIFE_DAYS=30

# --- routing overrides (optional) -------------------------------------------
# Per-task override on top of the preset, as JSON. See PLAN 3.2.
#   {"reflection": "ollama"}
DAEMON_ROUTE_OVERRIDES=
# One optional provider to try once when the routed provider fails. Unset means
# the error propagates instead of being silently papered over.
DAEMON_FALLBACK_PROVIDER=

# --- channel ----------------------------------------------------------------
# Create a bot with @BotFather (`daemon setup` opens it for you and verifies the
# token with getMe). Leave the allowlist empty: start the daemon, message your
# bot, and pair from the code it replies with - no hunting for a numeric id.
# Anyone not on the allowlist is ignored.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- PC control (tool use) --------------------------------------------------
# On by default: a companion that lives on your machine and cannot open a file on
# it is a chat window with extra steps. `daemon tools list` prints what it can do,
# `daemon tools log` prints what it has done including refusals, and `daemon doctor`
# says which way this is set.
#
# What makes that safe is the gate below, not this switch. Two rules hold whatever
# you set: nothing that changes the machine runs without your one-shot code (mode
# `ask`), and a tool never runs on a turn that is not your own words - a forward, an
# inline-bot result, anything recall dug up. See daemon/tools/policy.py.
#
# Set it to false to have none of it. Costs nothing either way except the tool list
# in the prompt (~800 tokens a turn, ~1,050 with the browser group on).
DAEMON_TOOLS_ENABLED=true

# How much it may do without asking:
#   off        nothing that changes the machine, ever (reading still works)
#   allowlist  only the commands below, and refuse everything else
#   ask        the commands below, and ask you about anything else
#   full       everything, no questions. Only the origin rule remains.
# `ask` is the useful default: you find out what it wants to run by being asked,
# and each request carries a one-shot code that expires in five minutes.
DAEMON_TOOLS_MODE=ask

# Commands that run without asking, as command prefixes, comma-separated.
# `git` would cover `git push` as well, so prefer the specific form.
#   DAEMON_TOOLS_ALLOWLIST=ls,pwd,date,git status,git diff
#
# An entry matches a bare command name only - the one PATH resolves to. `ls` here
# does NOT authorise `/tmp/somewhere/ls`, because a file merely named `ls` is not
# the command you allowed. An explicit path is always asked about.
#
# Think twice before allowlisting a network client. `curl` or `wget` here is an
# unguarded way out to any address, which is the one thing fetch_page refuses to
# be: it will not touch the private network, and `curl` has no such rule.
DAEMON_TOOLS_ALLOWLIST=

# Where the file tools may look, comma-separated. Narrow this if you can. Paths
# are resolved through symlinks before the check, and files holding credentials
# (.ssh, .env, *.pem, keychains) are refused inside any root.
DAEMON_TOOLS_ROOTS=~

# How long one command may run, how much of its output the model is given, and
# how many tool round-trips one turn may take before it has to answer.
DAEMON_TOOLS_TIMEOUT_SECS=20
DAEMON_TOOLS_MAX_OUTPUT=4000
DAEMON_TOOLS_MAX_ROUNDS=6

# --- browser (optional) -----------------------------------------------------
# Lets Daemon fetch web pages, see which tabs you have open, and read the text of
# the page in front of you - so you can say "what does this say?" instead of
# pasting it. Three tools: fetch_page, list_tabs, read_page. None of them click,
# type or navigate; for that, point DAEMON_MCP at a browser automation server.
#
# Its own switch rather than part of DAEMON_TOOLS_ENABLED, because this is the one
# group that reads a logged-in session: the page in front of you may be your bank.
# Letting it act on the machine and letting it read over your shoulder are two
# decisions.
#
# Reading page *contents* also needs a one-time toggle in Chrome itself:
#   menu bar > View > Developer > Allow JavaScript from Apple Events
# Until you set that, list_tabs works and read_page explains what is missing. Note
# what the toggle grants: any app that can send Apple events can then run
# JavaScript in your tabs. Daemon's own script is a fixed string that reads
# `innerText` and nothing else (daemon/tools/browser.py) - there is deliberately no
# tool that runs JavaScript you or the model supplies.
#
# macOS + Chromium only. Brave, Arc and Edge share Chrome's AppleScript
# dictionary, so naming one of those works. Safari's is a different shape.
DAEMON_BROWSER_ENABLED=false
DAEMON_BROWSER_APP=Google Chrome

# --- MCP servers (optional) -------------------------------------------------
# Needs the extra: pip install 'daemon-ai[mcp]'. Servers are declared in
# <DAEMON_DATA_DIR>/mcp.json, in the shape other MCP clients use:
#   {"servers": {"filesystem": {"command": "npx",
#      "args": ["-y", "@modelcontextprotocol/server-filesystem", "~"]}}}
# Their tools go through the same policy as the built-in ones - an MCP server is
# one more way to reach this machine. A server that fails to start is skipped and
# reported on /health, never fatal.
DAEMON_MCP_ENABLED=false

# --- data -------------------------------------------------------------------
# Markdown is the source of truth; the sqlite file is a rebuildable index.
DAEMON_DATA_DIR=./data

# --- local control plane ----------------------------------------------------
# Loopback on purpose: the HTTP surface is local, not a public API.
DAEMON_HOST=127.0.0.1
DAEMON_PORT=8787

# --- residency --------------------------------------------------------------
# `daemon install` writes ~/Library/LaunchAgents/ai.daemon.<label>.plist (macOS)
# or ~/.config/systemd/user/ai.daemon.<label>.service (Linux). Only change the
# label if you run a second instance with its own data dir.
# The unit file holds no secrets - it points at this directory and the process
# reads .env from here, so keep the file where you ran `daemon install`.
DAEMON_SERVICE_LABEL=default
